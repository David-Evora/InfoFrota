# Copie este arquivo para .env.api e preencha os valores localmente.
# Nunca versione .env.api nem compartilhe chaves reais.

INFOFROTA_PROVIDER=openai-compat
INFOFROTA_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=COLOQUE_SUA_CHAVE_AQUI

INFOFROTA_PROMPT=ultra
INFOFROTA_RAG=1
INFOFROTA_SHOTS=0
INFOFROTA_LIMITE_POR_MIN=30

# Opcional: habilita autenticação própria da API via X-API-Key.
# É uma chave interna diferente da chave do provedor LLM.
# INFOFROTA_API_KEY=DEFINA_UMA_CHAVE_INTERNA_FORTE

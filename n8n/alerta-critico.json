{
  "name": "InfoFrota - alerta de lotação crítica",
  "nodes": [
    {
      "id": "n1",
      "name": "A cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "n2",
      "name": "Configuração",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "api_url",
              "value": "http://localhost:8000",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "api_key",
              "value": "",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "webhook_url",
              "value": "COLE_AQUI_A_URL_DO_WEBHOOK_DO_SLACK_OU_DISCORD",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n3",
      "name": "Buscar alertas críticos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configuração').item.json.api_url }}/alertas",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "tipo",
              "value": "CRITICO"
            },
            {
              "name": "janela_horas",
              "value": "24"
            },
            {
              "name": "limite",
              "value": "10"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Configuração').item.json.api_key }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n4",
      "name": "Há alertas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.total }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      }
    },
    {
      "id": "n5",
      "name": "Montar mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -80
      ],
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst linhas = d.alertas.map(a => `• Linha ${a.linha} (${a.parada || 'sem parada'}): ${a.percentual}% às ${a.criado_em}`);\nconst texto = `🚨 ${d.total} alerta(s) crítico(s) nas últimas ${d.janela_horas}h (até ${d.referencia})\\n` + linhas.join('\\n') + '\\nDados sintéticos de demonstração.';\nreturn [{ json: { text: texto, content: texto } }];"
      }
    },
    {
      "id": "n6",
      "name": "Enviar notificação",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuração').item.json.webhook_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text, content: $json.content }) }}",
        "options": {}
      }
    }
  ],
  "pinData": {},
  "connections": {
    "A cada 5 minutos": {
      "main": [
        [
          {
            "node": "Configuração",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configuração": {
      "main": [
        [
          {
            "node": "Buscar alertas críticos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar alertas críticos": {
      "main": [
        [
          {
            "node": "Há alertas?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Há alertas?": {
      "main": [
        [
          {
            "node": "Montar mensagem",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Montar mensagem": {
      "main": [
        [
          {
            "node": "Enviar notificação",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}